# 密钥与本地环境
.env
.env.*
!.env.example
.venv/

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE（含本地 SDK 路径与个人配置）
.idea/
*.swp
*.swo

# 运行时日志与审计（含用户输入、路径、工具参数）
logs/
*.log

# 会话记忆（含用户内容）
memorys/chat_history/

# 回收区与备份（默认在用户目录；工作区设为项目根时会出现在这里）
.agent_trash/
.agent_backup/

# 临时文件
*.tmp
*.bak
~$*

# 本地需求文档（不纳入版本管理）
对RAG的初步要求.docx

# 操作系统杂物
.DS_Store
Thumbs.db
