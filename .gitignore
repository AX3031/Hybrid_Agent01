# 密钥与本地环境
.env
.env.*
!.env.example
.venv/

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE（含本地 SDK 路径与个人配置）
.idea/
*.swp
*.swo

# 运行时日志与审计（含用户输入、路径、工具参数）
logs/
*.log

# 会话记忆（含用户内容）
memorys/chat_history/

# 任务技能库（含用户保存的步骤与截图，保留在本机）
data/task_skills/

# 回收区、备份与守卫层状态（批次/会话快照/锁/急停）
.agent_trash/
.agent_backup/
.agent_state/

# 测试临时目录
_agent_verify_*/

# 临时文件
*.tmp
*.bak
~$*

# 本地需求文档（不纳入版本管理）
对OS_GUI_AGNET的初步要求.md
OS_GUI_AGENT_小企业版实施要求.md

# 操作系统杂物
.DS_Store
Thumbs.db
